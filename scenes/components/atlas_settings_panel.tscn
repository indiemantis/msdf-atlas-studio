[ext_resource type="Script" path="res://scenes/components/atlas_settings_panel.gd" id="1_script"]

[node name="AtlasSettingsPanel" type="VBoxContainer"]
offset_right = 320.0
offset_bottom = 380.0
theme_override_constants/separation = 8
script = ExtResource("1_script")

[node name="HeaderLabel" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "ATLAS CONFIGURATION"

[node name="Grid" type="GridContainer" parent="."]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 6
columns = 2

[node name="FieldTypeLabel" type="Label" parent="Grid"]
layout_mode = 2
text = "Field Type:"

[node name="FieldTypeOption" type="OptionButton" parent="Grid"]
layout_mode = 2
size_flags_horizontal = 3
fit_to_longest_item = false
tooltip_text = "Distance field algorithm: MSDF (Multi-channel Signed Distance Field), MTSDF, SDF, or Pseudo-SDF."

[node name="DimensionsLabel" type="Label" parent="Grid"]
layout_mode = 2
text = "Dimensions:"

[node name="DimBox" type="HBoxContainer" parent="Grid"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="WidthOption" type="OptionButton" parent="Grid/DimBox"]
layout_mode = 2
size_flags_horizontal = 3
fit_to_longest_item = false
tooltip_text = "Atlas texture width in pixels."

[node name="XLabel" type="Label" parent="Grid/DimBox"]
layout_mode = 2
text = "x"

[node name="HeightOption" type="OptionButton" parent="Grid/DimBox"]
layout_mode = 2
size_flags_horizontal = 3
fit_to_longest_item = false
tooltip_text = "Atlas texture height in pixels."

[node name="Empty" type="Control" parent="Grid"]
layout_mode = 2

[node name="AutoSizeCheck" type="CheckBox" parent="Grid"]
layout_mode = 2
tooltip_text = "Automatically determine the optimal power-of-two texture size to fit all glyphs."
text = "Auto Size"

[node name="PxRangeLabel" type="Label" parent="Grid"]
layout_mode = 2
text = "Pixel Range:"

[node name="PxRangeSpin" type="SpinBox" parent="Grid"]
layout_mode = 2
min_value = 1.0
max_value = 32.0
step = 0.5
value = 4.0
tooltip_text = "Distance field search radius in pixels. Controls anti-aliasing margin around glyph contours."

[node name="PaddingLabel" type="Label" parent="Grid"]
layout_mode = 2
text = "Padding:"

[node name="PaddingSpin" type="SpinBox" parent="Grid"]
layout_mode = 2
min_value = 0.0
max_value = 16.0
value = 2.0
tooltip_text = "Safety border padding in pixels between adjacent glyphs to prevent texture bleeding."

[node name="AngleLabel" type="Label" parent="Grid"]
layout_mode = 2
text = "Edge Angle:"

[node name="AngleSpin" type="SpinBox" parent="Grid"]
layout_mode = 2
min_value = 0.1
max_value = 6.28
step = 0.1
value = 3.0
tooltip_text = "Minimum corner angle threshold in radians used to separate RGB MSDF channels at sharp corners."

[node name="MiterLabel" type="Label" parent="Grid"]
layout_mode = 2
text = "Miter Limit:"

[node name="MiterSpin" type="SpinBox" parent="Grid"]
layout_mode = 2
min_value = 0.0
max_value = 10.0
step = 0.5
value = 1.0
tooltip_text = "Miter limit for sharp corner beveling in distance field generation."

[node name="PackingLabel" type="Label" parent="Grid"]
layout_mode = 2
text = "Packing:"

[node name="PackingOption" type="OptionButton" parent="Grid"]
layout_mode = 2
size_flags_horizontal = 3
fit_to_longest_item = false
tooltip_text = "2D bin-packing layout algorithm used to arrange glyph rectangles."

[node name="ActionContainer" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="GenerateButton" type="Button" parent="ActionContainer"]
custom_minimum_size = Vector2(80, 36)
